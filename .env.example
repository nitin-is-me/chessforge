# Copy to .env and fill in.
# Any Postgres 14+ server works (Supabase, Neon, Render Postgres, local docker).
# If the host offers a pooler, point DATABASE_URL at the transaction-mode pool
# and DIRECT_URL at a direct/session connection for migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
CLIENT_DEV_ORIGIN=http://localhost:5173
SESSION_SECRET=generate-a-long-random-string

# Brevo transactional email. Leave EMAIL_API_KEY empty to disable email flows.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ChessForge

# Bearer token required by /api/metrics in production.
METRICS_TOKEN=
